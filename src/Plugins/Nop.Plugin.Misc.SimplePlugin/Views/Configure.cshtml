@model Nop.Plugin.Misc.SimplePlugin.Models.SimplePluginModel
@{
    Layout = "_ConfigurePlugin";
}

<div class="card-body">
    <form asp-controller="SimplePlugin" asp-action="Configure" method="post">
        <div class="form-group">
            <label asp-for="EnableFeature">Enable Feature</label>
            <input asp-for="EnableFeature" type="checkbox" class="form-check-input" />
        </div>
        <div class="form-group">
            <label asp-for="WelcomeMessage">Welcome Message</label>
            <input asp-for="WelcomeMessage" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
    </form>
</div>